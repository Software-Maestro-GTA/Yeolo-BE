{
	"info": {
		"_postman_id": "9e0a1c7a-4f3b-4a21-8d55-yeolo000be02",
		"name": "Yeolo BE (prod)",
		"description": "Yeolo 백엔드 API 컬렉션 — **prod(운영) 대상**.\n\n⚠️ **실사용자 데이터를 건드립니다.** dev 컬렉션과 같은 요청이지만 대상이 운영 서버입니다.\n쓰기 API(프로필 수정·MBTI·동의·코스 생성)는 즉시 영구 반영되고, 코스 삭제·회원탈퇴는 되돌릴 수 없습니다.\n\n- 파괴적 요청(회원탈퇴·코스 삭제)은 기본으로 **차단**돼 있습니다. 정말 보낼 때만 컬렉션 변수\n  `allowDestructive` 를 `yes` 로 바꾸고, 끝나면 반드시 되돌리세요.\n- 토큰은 로그인으로만 얻습니다(tokenMode=mint 는 사용하지 않음).\n- 이 파일은 **main 브랜치의 API 계약**을 반영합니다. dev 가 앞서 나간 기능은 여기 없는 것이 정상입니다.\n- 상세는 docs/postman/README.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "00. Health",
			"description": "서버 상태 확인. 인증 불필요.",
			"item": [
				{
					"name": "GET /actuator/health",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/actuator/health",
						"description": "k8s readiness/liveness probe 와 같은 경로. status:UP 이면 준비 완료.",
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "01. Auth",
			"description": "로그인·토큰 재발급·로그아웃 (API-AUTH-1/2/3/4). 로그인 성공 시 accessToken·refreshToken·userId 가 환경변수에 자동 저장된다.",
			"item": [
				{
					"name": "POST 구글 로그인 (API-AUTH-1)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/auth/google",
						"description": "브라우저 OAuth 리다이렉트에서 받은 1회용 인가 코드를 보낸다. 로그인 URL 만드는 법은 docs/postman/README.md 7절. code 는 1회용이며 수 분 내 만료된다.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"{{googleAuthCode}}\",\n  \"redirectUri\": \"{{googleRedirectUri}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// [1] googleAuthCode 가 비었으면 로그인 URL 을 찍어 준다.",
									"// [2] 주소창을 통째로 붙여넣어도 code 만 뽑아 URL 디코딩한다.",
									"const cid  = pm.collectionVariables.get('googleClientId');",
									"const ruri = pm.collectionVariables.get('googleRedirectUri');",
									"let raw = (pm.collectionVariables.get('googleAuthCode') || '').trim();",
									"",
									"if (!raw) {",
									"    const authUrl = 'https://accounts.google.com/o/oauth2/v2/auth'",
									"        + '?client_id=' + cid",
									"        + '&redirect_uri=' + encodeURIComponent(ruri)",
									"        + '&response_type=code&scope=' + encodeURIComponent('openid email profile')",
									"        + '&prompt=consent';",
									"    console.log('[1] 아래 URL 을 브라우저(시크릿 창)에서 열고 로그인하세요.');",
									"    console.log(authUrl);",
									"    console.log('[2] 로그인 후 주소창을 통째로 googleAuthCode 에 붙여넣고 다시 Send 하세요.');",
									"    console.log('※ client_id 가 *****로 보이면 변수 Type 이 secret 입니다 — default 로 바꾸세요.');",
									"    console.log('※ client_id 는 .apps.googleusercontent.com 으로 끝나야 합니다. 잘리면 invalid_client.');",
									"} else {",
									"    const m = raw.match(/[?&]code=([^&]+)/);",
									"    if (m) { raw = m[1]; }",
									"    pm.variables.set('googleAuthCode', decodeURIComponent(raw));",
									"}"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (pm.response.code === 200 && res.data) {",
									"    pm.collectionVariables.set('accessToken', res.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
									"    if (res.data.user && res.data.user.userId) {",
									"        pm.collectionVariables.set('userId', res.data.user.userId);",
									"    }",
									"    // 명세 개정으로 추가된 최근 코스. 있으면 코스 상세 요청이 바로 쓸 수 있게 courseId 에 넣는다.",
									"    if (res.data.recentCourseId) {",
									"        pm.collectionVariables.set('courseId', res.data.recentCourseId);",
									"    }",
									"    console.log('로그인 성공 — accessToken/refreshToken/userId 저장');",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "POST 애플 로그인 (API-AUTH-2)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/auth/apple",
						"description": "idToken 은 선택. 네이티브에서 받은 값이 있으면 함께 보낸다.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"{{appleAuthCode}}\",\n  \"redirectUri\": \"{{appleRedirectUri}}\",\n  \"idToken\": \"{{appleIdToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (pm.response.code === 200 && res.data) {",
									"    pm.collectionVariables.set('accessToken', res.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
									"    if (res.data.user && res.data.user.userId) {",
									"        pm.collectionVariables.set('userId', res.data.user.userId);",
									"    }",
									"    // 명세 개정으로 추가된 최근 코스. 있으면 코스 상세 요청이 바로 쓸 수 있게 courseId 에 넣는다.",
									"    if (res.data.recentCourseId) {",
									"        pm.collectionVariables.set('courseId', res.data.recentCourseId);",
									"    }",
									"    console.log('로그인 성공 — accessToken/refreshToken/userId 저장');",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "POST 토큰 재발급 (API-AUTH-3)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/auth/refresh",
						"description": "Access/Refresh 를 함께 회전시킨다. 성공하면 옛 refreshToken 은 즉시 무효가 된다. 서버가 DB 의 해시와 대조하므로 로그인으로 받은 토큰에서만 동작한다.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (pm.response.code === 200 && res.data) {",
									"    pm.collectionVariables.set('accessToken', res.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
									"    console.log('토큰 회전 완료 — 옛 refreshToken 은 이 시점부터 무효');",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "POST 로그아웃 (API-AUTH-4)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/auth/logout",
						"description": "인증 필요. 세션(Refresh Token)을 지운다. 이후 재발급은 401.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Location",
			"description": "국가·도시 자동완성 (API-LOC-1/2). 명세상 인증 불필요한 공개 기준 데이터.",
			"item": [
				{
					"name": "GET 국가 자동완성 (API-LOC-1)",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/locations/countries/autocomplete?keyword=일&limit=10",
						"description": "keyword 는 한글 초성 검색도 지원한다. 둘 다 선택 파라미터.",
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				},
				{
					"name": "GET 도시 자동완성 (API-LOC-2)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/locations/cities/autocomplete?keyword=오사&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"locations",
								"cities",
								"autocomplete"
							],
							"query": [
								{
									"key": "country",
									"value": "JP",
									"description": "선택. 국가 식별자(ISO alpha-2) 또는 국가 한국어명(\"일본\"). 주면 그 국가로 좁힌다.",
									"disabled": true
