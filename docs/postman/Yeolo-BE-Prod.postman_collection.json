						"description": "명세가 자기모순이었으나 공개로 확정됐다 (docs/spec-index.md). country 는 명세 개정으로 추가된 선택 파라미터다 — 체크하면 그 국가의 도시만 나온다.",
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "03. User",
			"description": "프로필·MBTI·사진 동의·회원탈퇴. 04·05 의 전제조건이 여기에 있다.",
			"item": [
				{
					"name": "PATCH MBTI 등록/수정 (API-PREF-1)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/users/me/preferences",
						"description": "16유형이 아니면 400. 코스 생성(05)의 전제조건 중 하나다.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mbti\": \"ENFP\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "POST 사진 분석 동의 (API-PREF-2)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/users/me/consents/photo",
						"description": "동의하지 않으면 04 의 취향 분석이 403 으로 막힌다.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"agreed\": true,\n  \"consentVersion\": \"v1\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "PATCH 프로필 등록/수정 (API-USER-1)",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": "{{baseUrl}}/api/users/me/profile",
						"description": "multipart/form-data. 보낸 항목만 반영되는 부분 수정이며, 안 보낸 항목은 유지된다. profileImage 는 파일 선택 후 활성화. 사용자 행을 직접 읽으므로 users 에 없는 UUID 면 404. 명세 개정으로 email 은 요청에서 빠졌다 — 이메일은 OAuth 제공자 값만 쓰고 사용자가 고칠 수 없다(응답에는 그대로 실린다).",
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "displayName",
									"value": "테스터",
									"type": "text"
								},
								{
									"key": "profileImage",
									"type": "file",
									"disabled": true
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "DELETE 회원탈퇴 (API-USER-2) ⚠️",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/users/me",
						"description": "⚠️ 되돌릴 수 없다. 소프트 삭제 + 개인정보 파기 + 세션 무효화가 한 트랜잭션으로 실행되고, 이후 이 계정의 모든 요청이 401 이 된다(탈퇴자 차단). 폴더 실행 시 체크를 끌 것.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"테스트\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// prod 파괴적 요청 가드 — 실사용자 데이터가 지워지는 것을 막는다.",
									"// 정말 실행하려면 컬렉션 변수 allowDestructive 를 yes 로 바꾸고, 끝나면 되돌린다.",
									"if (String(pm.collectionVariables.get('allowDestructive')).toLowerCase() !== 'yes') {",
									"    const msg = 'prod 파괴적 요청 차단됨 — allowDestructive=yes 로 바꾸면 실행됩니다.';",
									"    // 러너에서는 이걸로 '건너뜀'으로 깔끔히 표시되고, 개별 Send 에서는 아무 효과가 없다.",
									"    if (pm.execution && typeof pm.execution.skipRequest === 'function') {",
									"        pm.execution.skipRequest();",
									"    }",
									"    // 개별 Send 를 실제로 막는 것은 이 throw 다. 어떤 경로에서도 요청이 나가지 않는다.",
									"    throw new Error(msg);",
									"}"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "04. Taste Profile",
