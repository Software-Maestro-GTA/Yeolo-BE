									"    // 'SHARE_LINK_BASE_URL 이 BE 도메인으로 잘못 설정'을 별도로 잡는다.",
									"    pm.expect(res.data.shareUrl).to.not.include(pm.collectionVariables.get('baseUrl'));",
									"});"
								]
							}
						}
					]
				},
