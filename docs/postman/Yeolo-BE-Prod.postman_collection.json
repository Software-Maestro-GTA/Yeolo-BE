					"response": []
				}
			]
		},
		{
			"name": "05. Course",
			"description": "코스 생성(SSE)·목록·상세·삭제 (API-COURSE-1/2/3/4). 목록/상세가 courseId·placeId 를 환경변수에 저장한다.",
			"item": [
				{
					"name": "POST 코스 생성 (API-COURSE-1, SSE)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "text/event-stream"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/courses",
						"description": "text/event-stream. 진행 이벤트는 LOADING_TASTE_PREFERENCE → GENERATING_COURSE → complete. budgetType 은 cost_effective|moderate|luxury 만 허용된다(명세값). MBTI 또는 취향 프로필 중 하나는 있어야 하며 둘 다 없으면 404.",
						"body": {
							"mode": "raw",
