									"if (pm.response.code === 200 && res.data && res.data.shareToken) {",
									"    pm.collectionVariables.set('shareToken', res.data.shareToken);",
									"    pm.collectionVariables.set('shareUrl', res.data.shareUrl);",
									"    console.log('shareToken 저장:', res.data.shareToken);",
									"    console.log('shareUrl :', res.data.shareUrl);",
									"}",
									"pm.test('200 + 명세 메시지', function () {",
									"    pm.expect(pm.response.code).to.eql(200);",
									"    pm.expect(res.message).to.eql('여행 코스 공유 링크 생성 성공');",
									"});",
									"",
									"// 링크가 FE 초대 페이지를 가리키는지. 경로가 어긋나면 발급은 200 인데 링크만 FE 404 가 되고,",
									"// 그 사실은 링크를 눌러 보기 전까지 드러나지 않는다. 코드 검사를 먼저 둬 실패 응답에서",
									"// res.data 가 null 일 때 TypeError 대신 깔끔한 실패 메시지가 나오게 한다.",
									"pm.test('shareUrl 이 FE 초대 페이지(/invite/<token>)를 가리킨다', function () {",
									"    pm.expect(pm.response.code).to.eql(200);",
									"    pm.expect(res.data.shareUrl).to.include('/invite/');",
									"    pm.expect(res.data.shareUrl).to.include(res.data.shareToken);",
