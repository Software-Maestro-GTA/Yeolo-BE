									"const text = pm.response.text();",
									"const m = text.match(/\"courseId\"\\s*:\\s*\"([0-9a-fA-F-]{36})\"/);",
									"if (m) { pm.collectionVariables.set('courseId', m[1]); console.log('courseId 저장:', m[1]); }",
									"const p = text.match(/\"placeId\"\\s*:\\s*\"([0-9a-fA-F-]{36})\"/);",
