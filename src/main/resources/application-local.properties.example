# ============================================================================
# 로컬 개발용 설정 템플릿 (추적됨). 이 파일을 복사해 실제 값을 채운 뒤 사용한다:
#
#   cp application-local.properties.example application-local.properties
#
# 실제 파일(application-local.properties)은 .gitignore로 커밋되지 않는다.
# 활성화: 앱 실행 시 local 프로파일을 켠다.
#   ./gradlew bootRun --args='--spring.profiles.active=local'
#   또는  export SPRING_PROFILES_ACTIVE=local
# (환경변수로 직접 주입해도 되며, 그 경우 이 파일 없이도 동작한다. docs/architecture.md §6)
# ============================================================================

# ===== DataSource (PostgreSQL) =====
spring.datasource.url=jdbc:postgresql://localhost:5432/yeolo
spring.datasource.username=postgres
spring.datasource.password=

# ===== Google OAuth (API-FB-1) =====
# https://console.cloud.google.com → OAuth 2.0 클라이언트 ID에서 발급
google.oauth.client-id=
google.oauth.client-secret=
google.oauth.redirect-uri=http://localhost:8080/login/oauth2/code/google

# ===== JWT =====
# HS256 서명용. 최소 32바이트(32자) 이상의 임의 문자열.
jwt.secret=CHANGE_ME_to_a_long_random_secret_at_least_32_bytes

# ===== AI 내부 API (API-BA-6) =====
# AI 엔진 서버 주소와 내부 인증 키(X-Internal-Api-Key)
ai.internal.base-url=http://localhost:8000
ai.internal.api-key=

# ===== Google Maps API 키 =====
# 필수는 'Geocoding API' 하나뿐이다(사진 EXIF 좌표 → 행정구역, DOM-5).
# 코스 생성은 AI가 장소 정보를 통째로 주므로(API-AI-2) Places API가 필요 없다.
# 키는 커밋하지 않는다 — 이 파일(gitignore)이나 GOOGLE_MAPS_API_KEY 환경변수로 주입한다.
geocode.google.api-key=

# ===== Reverse Geocode (DOM-5) =====
# provider: google(기본, 키 필요) | osm(OpenStreetMap, 키 불필요) | stub(키 불필요, 가짜 좌표)
# osm 선택 시 키는 필요 없으나, Nominatim 이용 정책상 앱/연락처를 식별하는 user-agent가 필요하다.
# 연락처(이메일/전화)는 커밋하지 말고 GEOCODE_OSM_USER_AGENT 환경변수로 주입한다.
#   예) export GEOCODE_OSM_USER_AGENT='Yeolo-BE/1.0 (contact: you@example.com)'
geocode.provider=google
geocode.google.nearby-radius=100
# 좌표 주변 POI 보강(선택). 이건 Geocoding이 아니라 'Places API (New)'라 키에 따로 열어야 한다 —
# 콘솔에서 활성화 + 키의 API 제한 목록에 추가한 뒤에만 값을 넣는다. 안 열려 있으면 사진마다
# 403 왕복만 늘어나므로 비워둔다(비면 호출을 건너뛰고 Geocoding 결과로 채운다).
#   geocode.google.search-nearby-url=https://places.googleapis.com/v1/places:searchNearby
geocode.google.search-nearby-url=

# ===== 장소 조회 (API-PLACE-1 / DOM-3) =====
# AI가 stop마다 장소 정보를 통째로 주므로 정상 경로에서는 호출되지 않는다 —
# 'AI가 식별자·좌표를 빠뜨렸을 때'만 타는 폴백 전용이다.
# provider: osm(기본, 키 불필요) | google(Places API (New) 필요) | stub(키 불필요, 합성 좌표)
# osm 선택 시 user-agent는 GEOCODE_OSM_USER_AGENT 환경변수를 공유한다.
place.provider=osm
place.google.api-key=
